#include <iostream>
using namespace std;

class Flight
{
private:
    const int flightNumber;
    static string airlineName;
    static int totalFlights;
public:
    Flight(int fn) : flightNumber(fn)
    {
        totalFlights++;
    }
    void showDetails() const
    {
        cout << "Airline: " << airlineName << " | Flight No: " << flightNumber << endl;
    }
    static int getTotalFlights()
    {
        return totalFlights;
    }
    ~Flight()
    {
        cout << "Flight record " << flightNumber << " removed from system." << endl;
    }
};
string Flight::airlineName = "SkyWings Airlines";
int Flight::totalFlights = 0;

int main()
{
    Flight fl1(101);
    Flight fl2(102);
    fl1.showDetails();
    fl2.showDetails();
    cout << "Total flights: " << Flight::getTotalFlights() << endl;
    return 0;
}
